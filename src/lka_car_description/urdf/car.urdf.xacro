<?xml version="1.0"?>
<robot name="lka_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Vehicle dimensions in metres -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width" value="0.22"/>
  <xacro:property name="chassis_height" value="0.08"/>
  <xacro:property name="wheel_radius" value="0.045"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheelbase" value="0.24"/>
  <xacro:property name="track_width" value="0.18"/>

  <!-- Chassis -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0"
               iyy="0.025" iyz="0" izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Front-left steering link -->
  <link name="front_left_steering_link"/>

  <!-- Front-right steering link -->
  <link name="front_right_steering_link"/>

  <!-- Wheel creation macro -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0002" ixy="0" ixz="0"
                 iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>

      <visual>
        <!-- Cylinder is rotated so its axis points along the axle -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.08 0.08 0.08 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Instantiate wheels -->
  <xacro:wheel name="front_left_wheel"/>
  <xacro:wheel name="front_right_wheel"/>
  <xacro:wheel name="rear_left_wheel"/>
  <xacro:wheel name="rear_right_wheel"/>

  <!-- Steering joints: rotation about the vertical Z axis -->
  <joint name="front_left_steering_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="${wheelbase/2} ${track_width/2} ${-chassis_height/2}"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="front_right_steering_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="${wheelbase/2} ${-track_width/2} ${-chassis_height/2}"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Front wheel rotation joints -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 ${-wheel_radius}"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 ${-wheel_radius}"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear wheel joints -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track_width/2} ${-chassis_height/2-wheel_radius}"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track_width/2} ${-chassis_height/2-wheel_radius}"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>

